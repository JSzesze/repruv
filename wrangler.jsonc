{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "url-to-markdown",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "limits": { "cpu_ms": 5000 },
  "routes": [
    {
      "pattern": "repruv.com/*",
      "zone_name": "repruv.com"
    },
    {
      "pattern": "www.repruv.com/*",
      "zone_name": "repruv.com"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "durable_objects": {
    "bindings": [
      { "name": "EXTRACTION_COORDINATOR", "class_name": "ExtractionCoordinator" },
      { "name": "FALLBACK_BUDGET", "class_name": "FallbackBudget" }
    ]
  },
  "migrations": [{ "tag": "v1-coordination", "new_sqlite_classes": ["ExtractionCoordinator", "FallbackBudget"] }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/health", "/md", "/md/"]
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS",
      "database_name": "repruv-analytics",
      "database_id": "d6c33a2c-483f-4f25-85c4-6db30f15a0bd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RESULTS",
      "bucket_name": "url-to-markdown-cache"
    }
  ],
  "ratelimits": [
    {
      "name": "MISS_LIMITER",
      "namespace_id": "19001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "CACHE_TTL_SECONDS": "604800",
    "ENABLE_BROWSER_FALLBACK": "true",
    "BROWSER_DAILY_LIMIT": "20",
    "BROWSER_MONTHLY_LIMIT": "300",
    "FIRECRAWL_DAILY_LIMIT": "0",
    "FIRECRAWL_MONTHLY_LIMIT": "0",
    "FALLBACK_CONCURRENCY": "2"
  }
}
